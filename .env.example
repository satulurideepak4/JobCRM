# Database
DATABASE_URL=postgresql://jobcrm:jobcrm@localhost:5431/jobcrm

# LLM Provider — pick one: gemini | openai | anthropic
LLM_PROVIDER=gemini

# API Keys — only fill the one matching LLM_PROVIDER
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Job Boards
RAPIDAPI_KEY=

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4445/auth/gmail/callback

# Scheduler
SYNC_HOUR=21
SYNC_MINUTE=30

# Startup behaviour
RUN_ON_STARTUP=false

# Daily digest email (leave blank to skip email; digest is always written to backend/digests/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_EMAIL=
